# Somnia Network Configuration
NETWORK_CHAIN_ID=50312
RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Trader Wallet Configuration
# Replace with your testnet private key (with or without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Trading Pair Configuration
TRADING_PAIR=BTC/USDso:USDso
DEFAULT_LEVERAGE=5

# Strategy Settings
STRATEGY=grid # Options: grid, momentum, sentinel, mm
GRID_LOWER_PRICE=60000
GRID_UPPER_PRICE=75000
GRID_LEVELS=10
ORDER_SIZE=0.01

# Operational Mode
DRY_RUN=true # Set to false to execute real transactions on testnet
LOG_LEVEL=info
